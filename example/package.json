{
  "name": "my-module",
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./.nuxt/module-builder/types.d.mts",
      "default": "./src/module.ts"
    },
    "./utils": "./src/utils.ts"
  },
  "main": "./src/module.ts",
  "typesVersions": {
    "*": {
      "utils": [
        "./dist/utils.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types.d.mts",
        "default": "./dist/module.mjs"
      },
      "./utils": "./dist/utils.mjs"
    },
    "main": "dist/module.mjs"
  },
  "scripts": {
    "prepack": "node ../src/cli.ts build",
    "dev": "node ../src/cli.ts prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "node ../src/cli.ts prepare && nuxt prepare playground",
    "test:types": "vue-tsc -b --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.7.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "latest",
    "nuxt": "^4.7.0"
  },
  "build": {
    "entries": [
      "./src/utils"
    ]
  }
}