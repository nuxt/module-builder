{
  "name": "@nuxt/module-builder",
  "version": "2.0.0-alpha.1",
  "repository": "nuxt/module-builder",
  "description": "Complete solution for building Nuxt modules",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./tsdown": "./dist/tsdown.mjs",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.mts"
      ],
      "tsdown": [
        "./dist/tsdown.d.mts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "bin": {
    "nuxt-build-module": "./dist/cli.mjs",
    "nuxt-module-build": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev:prepare": "pnpm -r dev:prepare",
    "example:build": "pnpm nuxt-module-build build ./example",
    "lint": "eslint .",
    "nuxt-module-build": "node ./src/cli.ts",
    "prepack": "pnpm build",
    "test": "pnpm vitest",
    "test:pack": "pnpm -C example pack --out ../.temp-pack/example.tgz && attw .temp-pack/example.tgz && publint .temp-pack/example.tgz",
    "test:engines": "pnpm exec installed-check -d --no-workspaces --ignore @nuxt/cli",
    "test:knip": "knip --exclude unresolved",
    "test:types": "vue-tsc --noEmit && pnpm -r test:types"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "browserslist": "^4.29.5",
    "citty": "^0.2.2",
    "clickable-path": "^0.1.1",
    "get-tsconfig": "^4.14.3",
    "lightningcss": "^1.33.0",
    "nostics": "^1.4.0",
    "pathe": "^2.0.3",
    "tinyglobby": "^0.2.17",
    "vue-sfc-transformer": "^0.3.5"
  },
  "peerDependencies": {
    "@nuxt/cli": "^3.37.0 || ^4.0.0",
    "@typescript/typescript6": "^6.0.0",
    "@typescript/typescript7": "npm:typescript@>=7.1.0-beta",
    "tsdown": "^0.23.7",
    "tsrs": ">=7.1.0-beta.tsrs3",
    "typescript": "^5.9.3 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@typescript/typescript6": {
      "optional": true
    },
    "@typescript/typescript7": {
      "optional": true
    },
    "tsrs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@arethetypeswrong/core": "^0.18.5",
    "@nuxt/cli": "^4.0.3",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/schema": "~4.6.4",
    "@oxc-project/types": "^0.157.0",
    "@types/node": "^26.6.6",
    "@typescript/typescript6": "6.0.2",
    "@typescript/typescript7": "npm:typescript@7.1.0-beta",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "installed-check": "^11.0.0",
    "knip": "^6.44.2",
    "nuxt": "~4.6.4",
    "ofetch": "^1.5.1",
    "pkg-pr-new": "^0.0.93",
    "publint": "^0.3.25",
    "sass": "^1.108.1",
    "tinyexec": "^1.3.1",
    "tsdown": "^0.23.7",
    "tsrs": "7.1.0-beta.tsrs3",
    "typescript": "~6.0.3",
    "verkit": "^0.5.0",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
